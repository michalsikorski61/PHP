{
    "name": "michalski/cou_laracasts_php_for_beginners",
    "autoload": {
        "psr-4": {
            "Michalski\\CouLaracastsPhpForBeginners\\": "src/",
            "Core\\": "Core/",
            "Http\\": "Http/"
        }
    },
    "authors": [
        {
            "name": "Michal Sikorski",
            "email": "michalsikorski61@gmail.com"
        }
    ],
    "require": {
        "illuminate/collections": "^12.17"
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
